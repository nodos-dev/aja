            {
              "id": "ba4f6464-0731-4e01-8607-1adbfe8f3c74",
              "name": "EncodeHDRMetadata",
              "class_name": "nos.mediaio.EncodeHDRMetadata",
              "pins": [
                {
                  "id": "25162f80-b786-4326-8497-b04a4b3322d8",
