                  "def": 0.0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Mastering-display peak luminance in cd/m^2. 0 = use the gamma-curve default (SDR 100 / HDR\n1000); any positive value overrides. Set this to match your actual grading display.",
                  "display_name": "Max Luminance (nits)"
                },
                {
                  "id": "2d296638-cc9a-4efe-b0fe-f07e904dd911",
