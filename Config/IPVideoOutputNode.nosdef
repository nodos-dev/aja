                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": true,
                  "def": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "When true, the SMPTE 352 payload identifier (VPID) is written to this SDI output's registers, derived from the output format plus the HDR signalling pins below. When false, the VPID registers are zeroed to suppress insertion.",
                  "display_name": "Enable VPID"
                },
