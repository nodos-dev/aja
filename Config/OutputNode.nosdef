                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Ancillary data packets to embed on this SDI output. Vendor / camera-control / arbitrary SMPTE 291 packets are forwarded to the AJA ANC inserter. ATC packets are dropped here (driven by the Timecode pin instead).",
                  "display_name": "ANC In"
                },
                {
                  "id": "403ccbb2-2157-401b-ad41-07880525278d",
                  "name": "EnableVPID",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": true,
                  "def": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "When true, the SMPTE 352 payload identifier (VPID) is written to this SDI output's registers, derived from the output format plus the HDR signalling pins below. When false, the VPID registers are zeroed to suppress insertion.",
                  "display_name": "Enable VPID"
                },
                {
                  "id": "3f5b11a1-7556-4a06-ba0e-9a763ab00f15",
