                    "red_y": 0.0,
                    "green_x": 0.0,
                    "green_y": 0.0,
                    "blue_x": 0.0,
                    "blue_y": 0.0,
                    "white_x": 0.0,
                    "white_y": 0.0,
                    "max_luminance": 0.0,
                    "min_luminance": 0.0,
                    "max_cll": 0,
                    "max_fall": 0
                  },
