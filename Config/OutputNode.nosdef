                  "max": {
                    "red_x": 0.0,
                    "red_y": 0.0,
                    "green_x": 0.0,
                    "green_y": 0.0,
                    "blue_x": 0.0,
                    "blue_y": 0.0,
                    "white_x": 0.0,
