            {
              "id": "a4de41c1-310f-4f12-b0a7-c74b8800b66a",
              "name": "EncodeHDRMetadata",
              "class_name": "nos.mediaio.EncodeHDRMetadata",
              "pins": [
                {
                  "id": "50e5f135-6007-46b9-8480-914775c2b833",
                  "name": "ColorSpace",
                  "type_name": "nos.mediaio.ColorSpace",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": "REC709",
                  "min": "REC709",
                  "max": "REC709",
                  "def": "REC2020",
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Selects the mastering-display primaries and white point (D65). REC2020 for wide-gamut HDR.",
                  "display_name": "Color Space"
                },
                {
                  "id": "78965b07-ea37-49b1-99d4-7ca0bde86c8f",
                  "name": "GammaCurve",
                  "type_name": "nos.mediaio.GammaCurve",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": "REC709",
                  "min": "REC709",
                  "max": "REC709",
                  "def": "ST2084",
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Only seeds the luminance defaults: REC709/SRGB are treated as SDR (100-nit), everything else\nas HDR (1000-nit). Has no field in ST 2086 itself. Signal the actual curve via the AJA Out\nnode's Gamma Curve (VPID) pin.",
                  "display_name": "Gamma Curve"
                },
                {
                  "id": "241b674e-593b-48f8-ba6c-59f97c0f5d5f",
                  "name": "MaxLuminance",
                  "type_name": "float",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 100.0,
                  "min": 0.0,
                  "def": 0.0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Mastering-display peak luminance in cd/m^2. 0 = use the gamma-curve default (SDR 100 / HDR\n1000); any positive value overrides. Set this to match your actual grading display.",
                  "display_name": "Max Luminance (nits)"
                },
                {
                  "id": "bac2dc8c-4a75-4715-8cda-b112cebd1bcf",
                  "name": "MinLuminance",
                  "type_name": "float",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 0.1,
                  "min": 0.0,
                  "def": 0.0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Mastering-display black level in cd/m^2. 0 = use the gamma-curve default (SDR 0.1 / HDR\n0.0001); any positive value overrides.",
                  "display_name": "Min Luminance (nits)"
                },
                {
                  "id": "7b4af1f7-0e7c-4b41-aed1-c160a5884740",
                  "name": "MaxCLL",
                  "type_name": "uint",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 0,
                  "def": 0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Maximum Content Light Level: the brightest pixel in the content. A MEASURED value \u2014 leave at\n0 (CTA-861.3 'unknown') unless you have real measured or upstream data. Not derived.",
                  "display_name": "MaxCLL (nits)"
                },
                {
                  "id": "474dd882-96c4-4e5d-ad44-c053473ee123",
                  "name": "MaxFALL",
                  "type_name": "uint",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 0,
                  "def": 0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Maximum Frame-Average Light Level: the brightest frame-average in the content. A MEASURED\nvalue \u2014 leave at 0 (CTA-861.3 'unknown') unless you have real data. Not derived.",
                  "display_name": "MaxFALL (nits)"
                },
                {
                  "id": "39fde45b-5f64-47d8-b888-79aa71b908db",
                  "name": "Out",
