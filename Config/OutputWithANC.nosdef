                {
                  "id": "3af62df6-f665-454c-b721-d4b232f85562",
                  "name": "EnableTimecode",
                  "type_name": "bool",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": true,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "When true, the Timecode pin value is emitted as RP188 ATC on this SDI output every frame via the AJA card's dedicated timecode emitter. When false, the SDI output's RP188 registers are left at their last written value (typically zero on cold start) and no Timecode-pin updates reach the wire.",
                  "display_name": "Enable Timecode"
                },
                {
                  "id": "10e0239c-d4a4-4b67-9547-e3288542a57d",
                  "name": "Timecode",
                  "type_name": "nos.mediaio.Timecode",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "ATC_LTC"
                  },
                  "min": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "max": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "def": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Decoded SMPTE timecode to embed on the SDI output. Consumed only when EnableTimecode is true. The Timecode.source field selects ATC carriage (LTC / VITC1 / VITC2); Auto is treated as LTC.",
                  "display_name": "Timecode"
                },
                {
                  "id": "a0243c62-f26e-452f-8878-f920d67d8495",
                  "name": "EnableVPID",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": true,
                  "def": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "When true, the HDR VPID fields (Gamma Curve / Color Space / Luminance / Signal Range) below override the SMPTE 352 VPID that the driver auto-generates on this SDI output. When false, the driver's default VPID is emitted unchanged (the base VPID is always present regardless).",
                  "display_name": "Enable VPID"
                },
                {
                  "id": "8794625a-8fa4-4173-a51a-3f8565d966eb",
                  "name": "GammaCurve",
                  "type_name": "nos.mediaio.GammaCurve",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": "REC709",
                  "def": "REC709",
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "VPID transfer characteristics for HDR signalling. REC709 and SRGB signal SDR; HLG and ST2084 signal the respective HDR curves; curves with no broadcast code (linear IDENTITY, camera-log SLOG3) are signalled as Unspecified.",
                  "display_name": "Gamma Curve"
                },
                {
                  "id": "dbbd262c-a2fc-4da8-a1e9-60f446183856",
                  "name": "ColorSpace",
                  "type_name": "nos.mediaio.ColorSpace",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": "REC709",
                  "def": "REC709",
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "VPID colorimetry. REC2020 signals wide-gamut UHDTV; REC709 and REC601 signal Rec709; gamuts with no VPID code (Sony SGAMUT3 / SGAMUT3CINE) are signalled as Unknown.",
                  "display_name": "Color Space"
                },
                {
                  "id": "66f606c7-c6ad-4aaa-a4ca-edc687a50546",
