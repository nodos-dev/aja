            {
              "id": "904c3167-bd31-4760-9526-2cb2ef88803e",
              "name": "EncodeHDRMetadata",
              "class_name": "nos.mediaio.EncodeHDRMetadata",
              "pins": [
                {
                  "id": "dfbda7b3-58df-4696-9188-3cf126a086df",
