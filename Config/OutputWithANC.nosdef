                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": 0,
                  "def": 0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Maximum Content Light Level: the brightest pixel in the content. A MEASURED value \u2014 leave at\n0 (CTA-861.3 'unknown') unless you have real measured or upstream data. Not derived.",
                  "display_name": "MaxCLL (nits)"
                },
                {
                  "id": "70464252-ae8d-46bf-882d-0e8e634112a5",
