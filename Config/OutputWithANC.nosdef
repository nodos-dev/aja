                  "display_name": "Out"
                },
                {
                  "id": "712b1059-0557-41c1-9a8f-02ce99fb756b",
                  "name": "Mode",
                  "type_name": "nos.mediaio.HDRMetadataMode",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizer": {
                  },
                  "data": "Auto",
                  "def": "Auto",
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Auto: luminance is derived from the gamma curve and the value pins below are read-only.\nCustom: the value pins become editable for real mastering / measured values.",
                  "display_name": "Mode"
                }
              ],
              "pos": { "x": 1009.0, "y": 863.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Assembles HDR10 static metadata (HDRMetadata) from a colour space and gamma curve. The\ncolour space selects the mastering-display primaries and white point (exact, standard values).\nThe gamma curve only seeds the luminance defaults (SDR ~100-nit, HDR ~1000-nit) \u2014 it has no\nfield of its own in SMPTE ST 2086. Feed the output into Inject HDR Metadata.\n\nMastering luminance is a real property of your grading/monitoring display: leave Max/Min\nLuminance at 0 to take the gamma-curve default, or set them explicitly. MaxCLL/MaxFALL are\nMEASURED content properties that cannot be derived \u2014 they default to 0, the CTA-861.3\n'unknown' value. Only set them if you have measured or upstream values; never invent them.",
              "display_name": "Encode HDR Metadata",
              "plugin_version": { "major": 2, "minor": 12, "patch": 0 }
            }
          ], "comments": [
            {
