                        ]
                      }
                    ] },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Output ANC frame with the ST 2108-1 HDR metadata packet appended at the selected VANC line.",
                  "display_name": "Out"
                },
                {
                  "id": "16c4155a-c7ad-4c8f-bb3e-134d61fce324",
                  "name": "ANCFrame",
                  "type_name": "nos.mediaio.ANCFrame",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_ONLY",
                  "visualizer": {
                  },
                  "data": { },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "description": "Optional source ANC frame. Packets other than ST 2108-1 (DID=0x41/SDID=0x0C) are forwarded\nverbatim. Leave unconnected to emit a fresh frame containing only the HDR metadata packet.",
                  "display_name": "ANC Frame"
                }
              ],
              "pos": { "x": 1240.0, "y": 736.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Builds a SMPTE ST 2108-1 HDR/WCG static-metadata Ancillary Data packet (DID=0x41,\nSDID=0x0C) from HDR10 mastering-display and content-light-level values, and injects it into\nan ANCFrame. Carries the HEVC mastering_display_colour_volume (SEI 137) and\ncontent_light_level_info (SEI 144) messages per ST 2086 / CTA-861.3. Existing ST 2108-1\npackets are stripped and replaced; all other packets pass through unchanged. If the input\nANCFrame is empty or unset, a fresh ANCFrame containing only the HDR packet is produced.\n\nWire Out into the AJA Out node's ANC In pin (with Enable ANC on) to signal HDR10 over SDI.\nComplements the VPID transfer/colorimetry signalling on the AJA Out node \u2014 set both.",
              "display_name": "Inject HDR Metadata",
              "plugin_version": { "major": 2, "minor": 12, "patch": 0 }
            },
