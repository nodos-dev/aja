            {
              "id": "80f73130-bc2c-4555-a61e-8ded35f54aa5",
              "name": "InjectHDRMetadata (1)",
              "class_name": "nos.mediaio.InjectHDRMetadata",
              "pins": [
                {
                  "id": "37a62495-f6b5-4929-b2c4-1826c848628e",
                  "name": "Metadata",
                  "type_name": "nos.mediaio.HDRMetadata",
                  "show_as": "INPUT_PIN",
