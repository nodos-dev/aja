{
	"nodes": [
		{
			"class_name": "DMAWrite",
			"menu_info": {
				"category": "Device|AJA",
				"class_name": "DMAWrite",
				"display_name": "DMA Write"
			},
			"node": {
				"class_name": "DMAWrite",
				"display_name": "AJA DMA Write",
				"contents_type": "Job",
				"description": "Sends YCbCr frames to the specified channel",
				"pins": [
					{
						"name": "Run",
						"type_name": "nos.exe",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "FieldType",
						"display_name": "Field Type",
						"type_name": "nos.sys.vulkan.FieldType",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": "PROGRESSIVE"
					},
					{
						"name": "Channel",
						"type_name": "nos.aja.ChannelInfo",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "CurrentVBL",
						"type_name": "uint",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "Input",
						"type_name": "nos.sys.vulkan.Buffer",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "EnableTimecode",
						"display_name": "Enable Timecode",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "When true, the Timecode pin value is emitted as RP188 ATC on this SDI output every frame via the AJA card's dedicated timecode emitter. When false, the SDI output's RP188 registers are left at their last written value (typically zero on cold start) and no Timecode-pin updates reach the wire.",
						"data": false
					},
					{
						"name": "Timecode",
						"display_name": "Timecode",
						"type_name": "nos.mediaio.Timecode",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Decoded SMPTE timecode to embed on the SDI output. Consumed only when EnableTimecode is true. The Timecode.source field selects ATC carriage (LTC / VITC1 / VITC2); Auto is treated as LTC."
					},
					{
						"name": "EnableVPID",
						"display_name": "Enable VPID",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "When true, the HDR VPID fields (Gamma Curve / Color Space / Luminance / Signal Range) below override the SMPTE 352 VPID that the driver auto-generates on this SDI output. When false, the driver's default VPID is emitted unchanged (the base VPID is always present regardless).",
						"data": true
					},
					{
						"name": "GammaCurve",
						"display_name": "Gamma Curve",
						"type_name": "nos.mediaio.GammaCurve",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "VPID transfer characteristics for HDR signalling. REC709 and SRGB signal SDR; HLG and ST2084 signal the respective HDR curves; curves with no broadcast code (linear IDENTITY, camera-log SLOG3) are signalled as Unspecified.",
						"data": "REC709"
					},
					{
						"name": "ColorSpace",
						"display_name": "Color Space",
						"type_name": "nos.mediaio.ColorSpace",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "VPID colorimetry. REC2020 signals wide-gamut UHDTV; REC709 and REC601 signal Rec709; gamuts with no VPID code (Sony SGAMUT3 / SGAMUT3CINE) are signalled as Unknown.",
						"data": "REC709"
					},
					{
						"name": "Luminance",
						"display_name": "Luminance",
						"type_name": "nos.mediaio.VPIDLuminance",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "VPID luminance signalling: YCbCr for conventional luma/chroma, ICtCp for constant-intensity HDR.",
						"data": "YCbCr"
					},
					{
						"name": "SignalRange",
						"display_name": "Signal Range",
						"type_name": "nos.mediaio.SignalRange",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "VPID quantization range: Narrow (SMPTE studio range) or Full.",
						"data": "Narrow"
					},
					{
						"name": "EnableANC",
						"display_name": "Enable ANC",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "When true, non-timecode packets in the ANCFrame input pin are inserted into the SDI ANC region for this frame. ATC packets (DID=0x60, SDID=0x60) are always stripped from the inserter list to avoid double-embedding with the dedicated RP188 hardware emitter — use the Timecode pin to drive ATC.",
						"data": false
					},
					{
						"name": "ANCFrame",
						"display_name": "ANC In",
						"type_name": "nos.mediaio.ANCFrame",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY",
						"description": "Ancillary data packets to embed on this SDI output. Vendor / camera-control / arbitrary SMPTE 291 packets are forwarded to the AJA ANC inserter. ATC packets are dropped here (driven by the Timecode pin instead)."
					}
				],
				"functions": [
					{
						"class_name": "Drop",
						"contents_type": "Job",
						"pins": [
							{
								"name": "Propagate",
								"type_name": "nos.exe",
								"show_as": "OUTPUT_PIN"
							}
						],
						"scheduling_type": "Event"
					}
				]
			}
		},
		{
			"class_name": "DMARead",
			"menu_info": {
				"category": "Device|AJA",
				"class_name": "DMARead",
				"display_name": "DMA Read"
			},
			"node": {
				"class_name": "DMARead",
				"display_name": "AJA DMA Read",
				"contents_type": "Job",
				"description": "Reads YCbCr frames from the specified channel",
				"pins": [
					{
						"name": "Run",
						"type_name": "nos.exe",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "DMA Complete",
						"type_name": "nos.exe",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					},
					{
						"name": "FieldType",
						"display_name": "Field Type",
						"type_name": "nos.sys.vulkan.FieldType",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": "PROGRESSIVE"
					},
					{
						"name": "Channel",
						"type_name": "nos.aja.ChannelInfo",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "BufferToWrite",
						"type_name": "nos.sys.vulkan.Buffer",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "CurrentVBL",
						"type_name": "uint",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "Output",
						"type_name": "nos.sys.vulkan.Buffer",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					},
					{
						"name": "EnableTimecode",
						"display_name": "Enable Timecode",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "When true, RP188 ATC is read from this SDI input each frame via the AJA card's dedicated timecode receiver and surfaced on the Timecode output pin. When false, the Timecode pin is not updated.",
						"data": false
					},
					{
						"name": "TimecodeSource",
						"display_name": "Timecode Source",
						"type_name": "nos.mediaio.ATCSource",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Selects which RP188 flavor the hardware receiver latches: ATC_LTC, ATC_VITC1, ATC_VITC2, or Auto (let the hardware pick the first valid one).",
						"data": 0
					},
					{
						"name": "Timecode",
						"display_name": "Timecode",
						"type_name": "nos.mediaio.Timecode",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY",
						"description": "Decoded SMPTE timecode read from the SDI input's RP188 ATC packet. Only updated when EnableTimecode is true and the hardware reported a valid timecode this frame."
					},
					{
						"name": "EnableANC",
						"display_name": "Enable ANC",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "When true, the ANC region of the incoming SDI is extracted into the ANCFrame output pin. ATC packets (DID=0x60, SDID=0x60) still appear here verbatim — for a decoded timecode value use EnableTimecode / Timecode.",
						"data": false
					},
					{
						"name": "ANCFrame",
						"display_name": "ANC Out",
						"type_name": "nos.mediaio.ANCFrame",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY",
						"description": "Ancillary data packets extracted from this SDI input's ANC region. Carries every SMPTE 291 packet the AJA extractor surfaces, with no DID filtering."
					}
				],
				"functions": [
					{
						"class_name": "Drop",
						"contents_type": "Job",
						"pins": [
							{
								"name": "Propagate",
								"type_name": "nos.exe",
								"show_as": "OUTPUT_PIN"
							}
						],
						"scheduling_type": "Event"
					}
				]
			}
		},
		{
			"class_name": "WaitVBL",
			"menu_info": {
				"category": "Device|AJA",
				"class_name": "WaitVBL",
				"display_name": "Wait VBL"
			},
			"node": {
				"class_name": "WaitVBL",
				"display_name": "AJA Wait VBL",
				"contents_type": "Job",
				"description": "",
				"pins": [
					{
						"name": "Run",
						"type_name": "nos.exe",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "VBL",
						"type_name": "nos.exe",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					},
					{
						"name": "WaitField",
						"display_name": "Wait Field",
						"type_name": "nos.sys.vulkan.FieldType",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": "PROGRESSIVE",
						"description": "Field to wait VBL on. If set to UNKNOWN, it will keep track of fields to wait on its own. If signal is progressive, this property is ignored."
					},
					{
						"name": "FieldType",
						"display_name": "Field Type",
						"type_name": "nos.sys.vulkan.FieldType",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_OR_PROPERTY",
						"data": "UNKNOWN",
						"description": "Which field this VBL belongs to",
						"readonly": true
					},
					{
						"name": "Channel",
						"type_name": "nos.aja.ChannelInfo",
						"show_as": "INPUT_PIN",
						"can_show_as": "INPUT_PIN_ONLY"
					},
					{
						"name": "CurrentVBL",
						"type_name": "uint",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					},
					{
						"name": "EnableSync",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"description": "Synchronize VBL with other I/O nodes' VBLs. If no common reference lock is used, this won't make much difference.",
						"data": true
					}
				],
				"functions": [
					{
						"class_name": "VBLFailed",
						"contents_type": "Job",
						"pins": [
							{
								"name": "Propagate",
								"type_name": "nos.exe",
								"show_as": "OUTPUT_PIN"
							}
						],
						"scheduling_type": "Event"
					},
					{
						"class_name": "Drop",
						"contents_type": "Job",
						"pins": [
							{
								"name": "Trigger",
								"type_name": "nos.exe",
								"show_as": "INPUT_PIN"
							}
						]
					}
				]
			}
		},
		{
