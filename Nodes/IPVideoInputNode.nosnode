            {
              "id": "284320d7-4357-4bb0-aaa5-51882f605ad9",
              "name": "Comment (5)",
              "hint": "Hint",
              "content": "Pushes textures to a ring buffer. Does not wait until capacity is full,\nserves frames as they come.",
              "pos": { "x": 1483.0, "y": 794.0 },
              "size": { "x": 432.0, "y": 229.0 },
              "bg_color": { "x": 1.0, "y": 0.0, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "38f1ee93-5a1d-4583-bebf-b279ee55120a",
              "name": "Comment (6)",
              "hint": "Hint",
              "content": "Read resolution and pixel format from \nchannel information to correctly interpret \ntexture buffer for YCbCr conversion node",
              "pos": { "x": -886.0, "y": 497.0 },
              "size": { "x": 274.0, "y": 134.0 },
              "bg_color": { "x": 0.0, "y": 0.0, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "ea48f334-2659-4a00-9322-4f1d2137f919",
              "name": "Comment (3)",
              "hint": "Hint",
              "content": "Generate 3x3 matrix for the YCbCr to RGB conversion for the selected Colorspace",
              "pos": { "x": 468.0, "y": 1268.0 },
              "size": { "x": 499.0, "y": 120.0 },
              "bg_color": { "x": 1.0, "y": 0.663717, "z": 0.0, "w": 0.3 }
