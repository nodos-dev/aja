          ], "comments": [
            {
              "id": "dcebf819-c339-458d-b976-07539c6cb263",
              "name": "Comment (3)",
              "hint": "Hint",
              "content": "Generate 3x3 matrix for the YCbCr to RGB conversion for the selected Colorspace",
              "pos": { "x": 994.0, "y": 1101.0 },
              "size": { "x": 603.0, "y": 120.0 },
              "bg_color": { "x": 1.0, "y": 0.663717, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "fb93581b-4700-4414-a1af-f8b953859255",
              "name": "Comment",
              "hint": "Hint",
              "content": "Wait on a thread for the VBL event to happen \n(provided through AJA API)\nfor the provided channel.",
              "pos": { "x": 184.0, "y": 615.0 },
              "size": { "x": 277.0, "y": 219.0 },
              "bg_color": { "x": 0.0, "y": 0.946903, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "98cdd3fd-7374-4a2d-8a05-4d6c54578d2d",
              "name": "Comment (2)",
              "hint": "Hint",
              "content": "Generate the selected 1DLUT to be used with the Compute shader",
              "pos": { "x": 1084.0, "y": 946.0 },
              "size": { "x": 421.0, "y": 113.0 },
              "bg_color": { "x": 0.0, "y": 0.348657, "z": 0.743363, "w": 0.3 }
            },
            {
              "id": "cb3d1e3b-d2ba-4d64-9e00-17b28146c26c",
              "name": "Comment (7)",
              "hint": "Hint",
              "content": "Provide & synchronize host buffers that DMA Read node will write to.",
              "pos": { "x": -374.5, "y": 518.0 },
              "size": { "x": 656.0, "y": 168.0 },
              "bg_color": { "x": 0.783186, "y": 0.696244, "z": 0.502486, "w": 0.3 }
            },
            {
              "id": "54201104-6b6d-4626-9672-a8a15d84366c",
              "name": "Comment (4)",
              "hint": "Hint",
              "content": "Convert from YCbCr UYVY8 and V210 formats to\nRGB using the input 1DLUT and Colorspace Matrix",
              "pos": { "x": 1883.0, "y": 892.0 },
              "size": { "x": 328.0, "y": 269.0 },
              "bg_color": { "x": 0.0, "y": 0.659292, "z": 0.344232, "w": 0.3 }
            },
            {
              "id": "36414ea5-cdf5-4626-b325-156b485cc659",
              "name": "Comment (5)",
              "hint": "Hint",
              "content": "Copy output texture to different texture every frame provided by the texture provider node.\nThey are then pushed to the object queue at the end of the DMA thread.",
              "pos": { "x": 2541.0, "y": 928.0 },
              "size": { "x": 910.0, "y": 327.0 },
              "bg_color": { "x": 0.0, "y": 0.548673, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "ed2d77a0-09bb-4735-9f9f-8c2851253c2a",
              "name": "Comment (1)",
              "hint": "Hint",
              "content": "Read AJA framebuffer to host memory and upload to GPU VRAM\nover PCIe interface of the GPU card using Vulkan drivers",
              "pos": { "x": 594.0, "y": 657.0 },
              "size": { "x": 398.0, "y": 253.0 },
              "bg_color": { "x": 1.0, "y": 0.345133, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "d9e144e2-9546-4095-83d7-bb918c2b9558",
              "name": "Comment (6)",
              "hint": "Hint",
              "content": "Read resolution and pixel format from \nchannel information to correctly interpret \ntexture buffer for YCbCr conversion node",
              "pos": { "x": -886.0, "y": 497.0 },
              "size": { "x": 274.0, "y": 134.0 },
              "bg_color": { "x": 0.0, "y": 0.0, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "bf5d4d5e-bfed-4b22-a5a2-30e9efb0ef77",
              "name": "Comment (8)",
              "hint": "Hint",
              "content": "Copy audio buffer to different buffer every frame to be pushed to the object queue at the end of the DMA thread.",
              "pos": { "x": 2420.0, "y": 608.0 },
              "size": { "x": 672.0, "y": 206.0 },
              "bg_color": { "x": 0.107918, "y": 0.938053, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "5e3c4868-54cb-4903-bd79-51233a88c8da",
              "name": "Comment (9)",
              "hint": "Hint",
              "content": "Queues audio-video composite objects into the bounded queue to be used by the consumer thread.\nSchedules DMA thread execution when a slot is available in the bounded queue.",
              "pos": { "x": 3455.0, "y": 627.0 },
              "size": { "x": 623.0, "y": 210.0 },
              "bg_color": { "x": 0.9, "y": 0.9, "z": 0.9, "w": 0.3 }
            },
            {
              "id": "82acdac7-51f9-406b-9dfb-94f96e8b607f",
              "name": "Comment (10)",
              "hint": "Hint",
              "content": "Provide a single host-visible audio buffer to be written into by the DMA read node.\nCalculates buffer size by assuming at most 1000 samples will be read/written by AJA every frame.",
              "pos": { "x": -345.0, "y": 771.0 },
              "size": { "x": 587.0, "y": 226.0 },
              "bg_color": { "x": 1.0, "y": 0.0, "z": 0.0, "w": 0.3 }
            }
          ], "connections": [
