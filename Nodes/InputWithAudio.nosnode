                {
                  "id": "ecd35b9a-0068-4ac6-a29a-d25ed1ccdb00",
                  "name": "EnableTimecode",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": false,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, RP188 ATC is read from this SDI input each frame via the AJA card's dedicated timecode receiver and surfaced on the Timecode output pin. When false, the Timecode pin is not updated.",
                  "display_name": "Enable Timecode"
                },
                {
                  "id": "8e7e6eac-632b-4e76-912f-109d91321f7d",
                  "name": "TimecodeSource",
