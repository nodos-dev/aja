                {
                  "id": "a35b50f9-63fe-435a-aeab-d3d00d4e7fa6",
                  "name": "EnableTimecode",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": false,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, the Timecode pin value is emitted as RP188 ATC on this SDI output every frame via the AJA card's dedicated timecode emitter. When false, the SDI output's RP188 registers are left at their last written value (typically zero on cold start) and no Timecode-pin updates reach the wire.",
                  "display_name": "Enable Timecode"
                },
                {
                  "id": "c5ff9038-28cc-4230-83fe-df120def3e30",
                  "name": "Timecode",
                  "type_name": "nos.mediaio.Timecode",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "def": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Decoded SMPTE timecode to embed on the SDI output. Consumed only when EnableTimecode is true. The Timecode.source field selects ATC carriage (LTC / VITC1 / VITC2); Auto is treated as LTC.",
                  "display_name": "Timecode"
                },
                {
                  "id": "e399cc28-3a33-4c16-aa8c-dca5fe331f97",
                  "name": "EnableANC",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": false,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, non-timecode packets in the ANCFrame input pin are inserted into the SDI ANC region for this frame. ATC packets (DID=0x60, SDID=0x60) are always stripped from the inserter list to avoid double-embedding with the dedicated RP188 hardware emitter \u2014 use the Timecode pin to drive ATC.",
                  "display_name": "Enable ANC"
                },
                {
                  "id": "9f96ced7-48ca-4c92-9431-4459cb947a2d",
                  "name": "ANCFrame",
                  "type_name": "nos.mediaio.ANCFrame",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_ONLY",
                  "visualizers": [],
                  "data": { "packets": [] },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Ancillary data packets to embed on this SDI output. Vendor / camera-control / arbitrary SMPTE 291 packets are forwarded to the AJA ANC inserter. ATC packets are dropped here (driven by the Timecode pin instead).",
                  "display_name": "ANC In"
                }
              ],
