          ], "comments": [
            {
              "id": "ad3ae4b6-9ca2-4d2f-bf69-4f5782f2d5d1",
              "name": "Comment (10)",
              "hint": "Hint",
              "content": "Wait for transfers of frame buffer to its host-visible buffer is completed.",
              "pos": { "x": 3106.0, "y": 647.0 },
              "size": { "x": 424.0, "y": 161.0 },
              "bg_color": { "x": 1.0, "y": 0.0, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "8a094ca5-5d20-4a59-a680-2a119e65b7a7",
              "name": "Comment (4)",
              "hint": "Hint",
              "content": "Convert Linear RGB texture to YCbCr UYVY8 or V210\nformat using input 1DLUT and 3x3 Colorspace Matrix",
              "pos": { "x": 290.0, "y": 883.0 },
              "size": { "x": 341.0, "y": 233.0 },
              "bg_color": { "x": 0.0, "y": 0.659292, "z": 0.344232, "w": 0.3 }
            },
            {
              "id": "ba811dde-4e6f-44da-a39b-f6e31fdbc7dc",
              "name": "Comment (9)",
              "hint": "Hint",
              "content": "Signal the buffer provider node that the use of its host-visible buffers for DMA are complete.",
              "pos": { "x": 4557.0, "y": 505.0 },
              "size": { "x": 735.0, "y": 197.0 },
              "bg_color": { "x": 1.0, "y": 0.0, "z": 0.876106, "w": 0.3 }
            },
            {
              "id": "da5eb5dd-cc97-4b15-8e08-67abae0127fb",
              "name": "Comment",
              "hint": "Hint",
              "content": "Wait on a thread for the VBL event to happen (provided through AJA API)\nfor the provided channel.",
              "pos": { "x": 3569.0, "y": 669.0 },
              "size": { "x": 436.0, "y": 275.0 },
              "bg_color": { "x": 0.0, "y": 0.946903, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "f1411554-87da-402c-9d79-21185a03a79f",
              "name": "Comment (6)",
              "hint": "Hint",
              "content": "Input Texture from Nodegraph",
              "pos": { "x": -933.0, "y": 596.0 },
              "size": { "x": 189.0, "y": 72.0 },
              "bg_color": { "x": 0.646018, "y": 1.0, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "e1061061-6fce-4546-b55e-591d532f52d7",
              "name": "Comment (1)",
              "hint": "Hint",
              "content": "Read from host memory and write to\nAJA framebuffer (with AJA DMA engines)\nover PCIe interface using AJA driver",
              "pos": { "x": 4004.0, "y": 532.0 },
              "size": { "x": 298.0, "y": 310.0 },
              "bg_color": { "x": 1.0, "y": 0.345133, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "4d947340-2641-4a52-a62f-ea158c893475",
              "name": "Comment (3)",
              "hint": "Hint",
              "content": "Generate 3x3 matrix for the RGB to YCbCr conversion for the selected Colorspace",
              "pos": { "x": -486.0, "y": 956.0 },
              "size": { "x": 499.0, "y": 107.0 },
              "bg_color": { "x": 1.0, "y": 0.663717, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "611588c6-2179-4228-8f29-1072e8a03ecd",
              "name": "Comment (7)",
              "hint": "Hint",
              "content": "Resize input to AJA resolution\nOnly if they are not the same resolution",
              "pos": { "x": -75.0, "y": 752.0 },
              "size": { "x": 269.0, "y": 150.0 },
              "bg_color": { "x": 0.375441, "y": 0.623894, "z": 0.498568, "w": 0.3 }
            },
            {
              "id": "954873a0-bea1-41f2-a9f4-eeea82511cdb",
              "name": "Comment (2)",
              "hint": "Hint",
              "content": "Generate the selected 1DLUT to be used with the Compute shader",
              "pos": { "x": -531.0, "y": 806.0 },
              "size": { "x": 418.0, "y": 113.0 },
              "bg_color": { "x": 0.0, "y": 0.348657, "z": 0.743363, "w": 0.3 }
            },
            {
              "id": "6f6657a0-cdc6-44a2-bb31-5e049bb3170a",
              "name": "Comment (12)",
              "hint": "Hint",
              "content": "AJA expects a sample rate of 48000 and 6 channels. Resample if the input is not compatible.",
              "pos": { "x": 556.0, "y": 1146.0 },
              "size": { "x": 543.0, "y": 163.0 },
              "bg_color": { "x": 1.0, "y": 0.0, "z": 0.902655, "w": 0.3 }
            },
            {
              "id": "13352f84-15b1-48f0-a6a0-5f0d4005ae72",
              "name": "Comment (8)",
              "hint": "Hint",
              "content": "Wait for an empty slot in the ring and insert the VideoFrame object containing frame buffer & audio buffer, and the synchronization primitives.",
              "pos": { "x": 2187.0, "y": 852.0 },
              "size": { "x": 395.0, "y": 217.0 },
              "bg_color": { "x": 0.0, "y": 1.0, "z": 0.070796, "w": 0.3 }
            },
            {
              "id": "62364737-406d-4f46-9381-7592c0e7dac8",
              "name": "Comment (5)",
              "hint": "Hint",
              "content": "Transfers the frame buffer in VRAM to host memory (over the PCIe bus a.k.a Readback) & copy the host-visible audio buffer to a new buffer. \nThe output objects are then pushed to the ring buffer, after which the DMA thread pops them and signals promises when usage is finished.",
              "pos": { "x": 1074.0, "y": 849.0 },
              "size": { "x": 874.0, "y": 321.0 },
              "bg_color": { "x": 0.884955, "y": 0.0, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "7015329f-0f51-49a1-b0ae-aa7e2e2e2e56",
              "name": "Comment (11)",
              "hint": "Hint",
              "content": "Device & channel configuration for AJA cards.",
              "pos": { "x": 2470.0, "y": 510.0 },
              "size": { "x": 793.0, "y": 310.0 },
              "bg_color": { "x": 0.0, "y": 0.38938, "z": 1.0, "w": 0.3 }
            }
