            {
              "id": "740280c9-80f6-4004-be63-49a5359054ae",
              "name": "Comment (5)",
              "hint": "Hint",
              "content": "Transfer the buffer in VRAM to host memory (over the PCIe bus a.k.a Readback).",
              "pos": { "x": 595.0, "y": 652.0 },
              "size": { "x": 510.0, "y": 250.0 },
              "bg_color": { "x": 0.884955, "y": 0.0, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "4216593f-47e8-4c47-ab58-5c34d7c1d255",
              "name": "Comment (4)",
              "hint": "Hint",
              "content": "Convert Linear RGB texture to YCbCr UYVY8 or V210\nformat using input 1DLUT and 3x3 Colorspace Matrix",
              "pos": { "x": 261.0, "y": 937.0 },
              "size": { "x": 341.0, "y": 233.0 },
              "bg_color": { "x": 0.0, "y": 0.659292, "z": 0.344232, "w": 0.3 }
            },
            {
              "id": "e954908f-e884-4211-9e85-f078a4de1320",
              "name": "Comment (1)",
              "hint": "Hint",
              "content": "Read from host memory and write to\nAJA framebuffer (with AJA DMA engines)\nover PCIe interface using AJA driver",
              "pos": { "x": 2698.0, "y": 576.0 },
              "size": { "x": 250.0, "y": 257.0 },
              "bg_color": { "x": 1.0, "y": 0.345133, "z": 0.0, "w": 0.3 }
