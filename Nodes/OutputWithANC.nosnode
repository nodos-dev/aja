                {
                  "id": "fea85c72-d357-4f8b-9183-c36b90fce00a",
                  "name": "EnableTimecode",
                  "type_name": "bool",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": true,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, the Timecode pin value is emitted as RP188 ATC on this SDI output every frame via the AJA card's dedicated timecode emitter. When false, the SDI output's RP188 registers are left at their last written value (typically zero on cold start) and no Timecode-pin updates reach the wire.",
                  "display_name": "Enable Timecode"
                },
                {
                  "id": "dc2d214f-92ab-41e2-9a50-ae63209b711b",
                  "name": "Timecode",
                  "type_name": "nos.mediaio.Timecode",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": {
                    "hours": 13,
                    "minutes": 6,
                    "seconds": 7,
                    "frames": 3,
                    "drop_frame": false,
                    "source": "ATC_LTC"
                  },
                  "def": {
                    "hours": 0,
                    "minutes": 0,
                    "seconds": 0,
                    "frames": 0,
                    "drop_frame": false,
                    "source": "Auto"
                  },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Decoded SMPTE timecode to embed on the SDI output. Consumed only when EnableTimecode is true. The Timecode.source field selects ATC carriage (LTC / VITC1 / VITC2); Auto is treated as LTC.",
                  "display_name": "Timecode"
                },
                {
                  "id": "2e351121-5de3-4e9f-a5e7-8f9a41ce98f9",
                  "name": "EnableANC",
                  "type_name": "bool",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": true,
                  "def": false,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, non-timecode packets in the ANCFrame input pin are inserted into the SDI ANC region for this frame. ATC packets (DID=0x60, SDID=0x60) are always stripped from the inserter list to avoid double-embedding with the dedicated RP188 hardware emitter \u2014 use the Timecode pin to drive ATC.",
                  "display_name": "Enable ANC"
                },
                {
                  "id": "0453f129-1336-47cf-81cb-81750eff7bf5",
                  "name": "ANCFrame",
                  "type_name": "nos.mediaio.ANCFrame",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_ONLY",
                  "visualizers": [],
                  "data": { "packets": [
                      {
                        "did": 96,
                        "sdid": 96,
                        "line_number": 10,
                        "horiz_offset": 0,
                        "space": "VANC",
                        "channel": "Y",
                        "link": "A",
                        "stream": "Unknown",
                        "is_field2": false,
                        "coding": "Digital",
                        "payload": [
                          16,
                          0,
                          0,
                          0,
                          112,
                          0,
                          128,
                          0,
                          96,
                          0,
                          0,
                          0,
                          48,
                          0,
                          16,
                          0
                        ]
                      }
                    ] },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Ancillary data packets to embed on this SDI output. Vendor / camera-control / arbitrary SMPTE 291 packets are forwarded to the AJA ANC inserter. ATC packets are dropped here (driven by the Timecode pin instead).",
                  "display_name": "ANC In"
                },
                {
                  "id": "dbf328c9-e455-4898-a4e9-c6b06ad69063",
                  "name": "EnableVPID",
                  "type_name": "bool",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": true,
                  "def": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "When true, the HDR VPID fields (Gamma Curve / Color Space / Luminance / Signal Range) below override the SMPTE 352 VPID that the driver auto-generates on this SDI output. When false, the driver's default VPID is emitted unchanged (the base VPID is always present regardless).",
                  "display_name": "Enable VPID"
                },
                {
                  "id": "21a93074-d394-4cb5-953c-d7e6cafac7ef",
                  "name": "GammaCurve",
                  "type_name": "nos.mediaio.GammaCurve",
