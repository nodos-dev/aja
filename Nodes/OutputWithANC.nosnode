                  "visualizers": [],
                  "data": 1.0,
                  "def": 1.0,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Safety cap on how long a single FixedStep run may block, so a bad\nDelta Seconds can't stall the engine thread. 0 disables the cap.",
                  "display_name": "Max Wait Seconds"
                }
              ],
