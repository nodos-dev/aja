              ],
              "pos": { "x": 2385.0, "y": 1035.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Assembles HDR10 static metadata (HDRMetadata) from a colour space and gamma curve. The\ncolour space selects the mastering-display primaries and white point (exact, standard values).\nFeed the output into Inject HDR Metadata.\n\nMode = Auto derives the luminance from the gamma curve (SDR ~100-nit, HDR ~1000-nit) and\nleaves MaxCLL/MaxFALL at 0 (CTA-861.3 'unknown', the honest value for a live signal); the\nvalue pins are read-only and show what will be sent. Mode = Custom unlocks them so you can\nenter your real mastering-display luminance and measured content light levels. Never invent\nMaxCLL/MaxFALL \u2014 a display tone-maps against whatever you claim.",
              "display_name": "Encode HDR Metadata",
              "plugin_version": { "major": 4, "minor": 0, "patch": 0 }
            },
