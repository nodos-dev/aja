            {
              "id": "4d9adc12-c97b-41d6-80c5-6e76c5b4d0fb",
              "name": "Comment (1)",
              "hint": "Hint",
              "content": "Read from host memory and write to\nAJA framebuffer (with AJA DMA engines)\nover PCIe interface using AJA driver",
              "pos": { "x": 2857.0, "y": 554.0 },
              "size": { "x": 250.0, "y": 331.0 },
              "bg_color": { "x": 1.0, "y": 0.345133, "z": 0.0, "w": 0.3 }
            },
            {
              "id": "8640ef4c-82d7-4275-bcab-1c8a304ec770",
              "name": "Comment (8)",
              "hint": "Hint",
              "content": "Wait on a thread for the VBL event to happen (provided through AJA API) for the provided channel.",
              "pos": { "x": 2490.0, "y": 532.0 },
              "size": { "x": 436.0, "y": 281.0 },
              "bg_color": { "x": 0.0, "y": 0.946903, "z": 1.0, "w": 0.3 }
            },
            {
              "id": "058accca-99fc-4c46-a593-7b59b50e657b",
              "name": "Comment (9)",
              "hint": "Hint",
              "content": "Wait for an empty slot in the ring\nand insert the buffer-sync primitives object tuple.",
              "pos": { "x": 1457.0, "y": 734.0 },
              "size": { "x": 295.0, "y": 192.0 },
              "bg_color": { "x": 0.0, "y": 1.0, "z": 0.070796, "w": 0.3 }
            },
            {
              "id": "f36e54df-4286-44ba-8570-ffcaea4f7b32",
              "name": "Comment (6)",
              "hint": "Hint",
              "content": "Input Texture from Nodegraph",
