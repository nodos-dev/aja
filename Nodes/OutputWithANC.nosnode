            {
              "id": "5299bbc8-4865-4c45-8352-b8ce755d55b7",
              "name": "EncodeHDRMetadata",
              "class_name": "nos.mediaio.EncodeHDRMetadata",
              "pins": [
                {
                  "id": "ecb652d2-fc6d-41b0-ae2d-d0ea6c2ea5f5",
                  "name": "Mode",
                  "type_name": "nos.mediaio.HDRMetadataMode",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": "Auto",
                  "def": "Auto",
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Auto: luminance is derived from the gamma curve and the value pins below are read-only.\nCustom: the value pins become editable for real mastering / measured values.",
                  "display_name": "Mode"
                },
                {
                  "id": "f6f2884c-7beb-41f9-a564-d8395393115e",
                  "name": "ColorSpace",
                  "type_name": "nos.mediaio.ColorSpace",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": "REC709",
                  "def": "REC2020",
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Selects the mastering-display primaries and white point (D65). REC2020 for wide-gamut HDR.",
                  "display_name": "Color Space"
                },
                {
                  "id": "0ccbc347-c17a-46bb-bf7a-e89a1252fefb",
                  "name": "GammaCurve",
                  "type_name": "nos.mediaio.GammaCurve",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": "REC709",
                  "def": "ST2084",
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "In Auto mode, selects the luminance defaults (REC709/SRGB = SDR 100-nit, else HDR 1000-nit).\nHas no field in ST 2086 itself and is ignored in Custom mode. Signal the actual curve via the\nAJA Out node's Gamma Curve (VPID) pin.",
                  "display_name": "Gamma Curve"
                },
                {
                  "id": "5057b9a1-ec93-4b09-a6ef-54c67f7a33e9",
                  "name": "MaxLuminance",
                  "type_name": "float",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 100.0,
                  "min": 0.0,
                  "def": 0.0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Mastering-display peak luminance in cd/m^2. Read-only in Auto (derived from the gamma curve);\nset it to your actual grading display's peak in Custom mode.",
                  "display_name": "Max Luminance (nits)"
                },
                {
                  "id": "3ee8551c-aa37-4973-80ac-4c1b3e4dd4e0",
                  "name": "MinLuminance",
                  "type_name": "float",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 0.1,
                  "min": 0.0,
                  "def": 0.0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Mastering-display black level in cd/m^2. Read-only in Auto (derived from the gamma curve);\nset it to your actual grading display's black level in Custom mode.",
                  "display_name": "Min Luminance (nits)"
                },
                {
                  "id": "a446b9b5-d38a-4561-abbb-06f518639cc6",
                  "name": "MaxCLL",
                  "type_name": "uint",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 0,
                  "def": 0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Maximum Content Light Level: the brightest pixel in the content. A MEASURED value — 0 means\n'unknown' per CTA-861.3 (the honest default for live). Editable only in Custom mode.",
                  "display_name": "MaxCLL (nits)"
                },
                {
                  "id": "745b9582-636d-4846-a308-d3a7ac039239",
                  "name": "MaxFALL",
                  "type_name": "uint",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 0,
                  "def": 0,
                  "readonly": true,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Maximum Frame-Average Light Level: the brightest frame-average in the content. A MEASURED\nvalue — 0 means 'unknown' per CTA-861.3. Editable only in Custom mode.",
                  "display_name": "MaxFALL (nits)"
                },
                {
                  "id": "9b3cbff4-34f3-4e22-bfea-5d9e182862ae",
                  "name": "Out",
                  "type_name": "nos.mediaio.HDRMetadata",
                  "show_as": "OUTPUT_PIN",
                  "can_show_as": "OUTPUT_PIN_ONLY",
                  "visualizers": [],
                  "data": { },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "HDR10 static metadata assembled from the inputs. Wire into Inject HDR Metadata's Metadata pin.",
                  "display_name": "Out"
                }
              ],
              "pos": { "x": 2250.0, "y": 1040.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Assembles HDR10 static metadata (HDRMetadata) from a colour space and gamma curve. The\ncolour space selects the mastering-display primaries and white point (exact, standard values).\nFeed the output into Inject HDR Metadata.\n\nMode = Auto derives the luminance from the gamma curve (SDR ~100-nit, HDR ~1000-nit) and\nleaves MaxCLL/MaxFALL at 0 (CTA-861.3 'unknown', the honest value for a live signal); the\nvalue pins are read-only and show what will be sent. Mode = Custom unlocks them so you can\nenter your real mastering-display luminance and measured content light levels. Never invent\nMaxCLL/MaxFALL — a display tone-maps against whatever you claim.",
              "display_name": "Encode HDR Metadata",
              "plugin_version": { "major": 4, "minor": 0, "patch": 0 }
            },
            {
              "id": "b936d6ac-6b20-4e33-bda2-57b6fe61a8b6",
              "name": "InjectHDRMetadata (1)",
              "class_name": "nos.mediaio.InjectHDRMetadata",
              "pins": [
                {
                  "id": "b42254bb-e79e-48eb-bc17-12301c59eec9",
                  "name": "Metadata",
                  "type_name": "nos.mediaio.HDRMetadata",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": { },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "HDR10 static metadata in physical units (CIE xy chromaticities, nits). Defaults describe a\nRec.2020 / D65 / 1000-nit mastering display. The node applies the ST 2086 scaling.",
                  "display_name": "Metadata"
                },
                {
                  "id": "2fa6f89d-31d5-4276-b0ca-1875f0c4e5fd",
                  "name": "LineNumber",
                  "type_name": "uint",
                  "show_as": "PROPERTY",
                  "can_show_as": "INPUT_PIN_OR_PROPERTY",
                  "visualizers": [],
                  "data": 9,
                  "min": 9,
                  "def": 9,
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "SMPTE line number in the vertical ancillary space to carry the HDR metadata packet.",
                  "display_name": "VANC Line"
                },
                {
                  "id": "7c6220fc-4dbf-4eaf-a0b9-2b11636ab75a",
                  "name": "Out",
                  "type_name": "nos.mediaio.ANCFrame",
                  "show_as": "OUTPUT_PIN",
                  "can_show_as": "OUTPUT_PIN_ONLY",
                  "visualizers": [],
                  "data": { "packets": [] },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Output ANC frame with the ST 2108-1 HDR metadata packet appended at the selected VANC line.",
                  "display_name": "Out"
                },
                {
                  "id": "f24a819d-061d-4119-97ac-e41421078d7c",
                  "name": "ANCFrame",
                  "type_name": "nos.mediaio.ANCFrame",
                  "show_as": "INPUT_PIN",
                  "can_show_as": "INPUT_PIN_ONLY",
                  "visualizers": [],
                  "data": { },
                  "def": { },
                  "contents_type": "JobPin",
                  "contents": { },
                  "orphan_state": { },
                  "description": "Optional source ANC frame. Packets other than ST 2108-1 (DID=0x41/SDID=0x0C) are forwarded\nverbatim. Leave unconnected to emit a fresh frame containing only the HDR metadata packet.",
                  "display_name": "ANC Frame"
                }
              ],
              "pos": { "x": 2560.0, "y": 1040.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Builds a SMPTE ST 2108-1 HDR/WCG static-metadata Ancillary Data packet (DID=0x41,\nSDID=0x0C) from HDR10 mastering-display and content-light-level values, and injects it into\nan ANCFrame. Carries the HEVC mastering_display_colour_volume (SEI 137) and\ncontent_light_level_info (SEI 144) messages per ST 2086 / CTA-861.3. Existing ST 2108-1\npackets are stripped and replaced; all other packets pass through unchanged. If the input\nANCFrame is empty or unset, a fresh ANCFrame containing only the HDR packet is produced.\n\nWire Out into the AJA Out node's ANC In pin (with Enable ANC on) to signal HDR10 over SDI.\nComplements the VPID transfer/colorimetry signalling on the AJA Out node — set both.",
              "display_name": "Inject HDR Metadata",
              "plugin_version": { "major": 4, "minor": 0, "patch": 0 }
            },
