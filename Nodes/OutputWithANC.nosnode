                  "contents": { },
                  "orphan_state": { },
                  "description": "VPID colorimetry. REC2020 signals wide-gamut UHDTV; REC709 and REC601 signal Rec709; gamuts with no VPID code (Sony SGAMUT3 / SGAMUT3CINE) are signalled as Unknown.",
                  "display_name": "Color Space"
                },
