              ],
              "pos": { "x": 1085.0, "y": 769.0 },
              "contents_type": "Job",
              "contents": { "type": "" },
              "function_category": "Default Node",
              "description": "Encodes a SMPTE ST 12-2 Ancillary Timecode (ATC) packet from a decoded Timecode struct and\ninjects it into an ANCFrame. Existing ATC packets matching the same flavor (LTC/VITC1/VITC2)\non the same field are stripped and replaced; all other packets pass through unchanged. If the\ninput ANCFrame is empty or unset, a fresh ANCFrame containing only the encoded ATC packet is\nproduced.\n\nFor SDI output via AJA, prefer wiring Timecode directly into the AJA Out node's Timecode pin\n\u2014 the AJA hardware drives RP188 ATC through the dedicated emitter and the inserter path is\nfor vendor packets. Use this node for non-AJA outputs (2110, file writers) or when you need\nthe ATC packet as data inside an ANCFrame.",
              "display_name": "Inject Timecode",
              "plugin_version": { "major": 4, "minor": 0, "patch": 0 }
            },
